<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todo" Width="520" Height="600"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewText" Grid.Column="0" Padding="6"
                     VerticalContentAlignment="Center"
                     KeyDown="NewText_KeyDown"/>
            <Button Grid.Column="1" Content="Добавить" Padding="12,6"
                    Margin="8,0,0,0" Click="Add_Click"/>
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Все" Tag="all" Click="Filter_Click" Margin="0,0,8,0"/>
            <Button Content="Активные" Tag="active" Click="Filter_Click" Margin="0,0,8,0"/>
            <Button Content="Выполненные" Tag="done" Click="Filter_Click"/>
        </StackPanel>

        <ListBox x:Name="List" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" IsChecked="{Binding Done, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <TextBlock Grid.Column="1" Text="{Binding Text}"
                                   VerticalAlignment="Center">
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Редактировать" Click="Edit_Click"/>
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                            <Setter Property="Foreground" Value="Gray"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Grid.Column="2" Content="✕" Padding="6,2" Click="Delete_Click"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>