<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:TodoApp"
        Title="Todo List" Height="500" Width="800"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

       
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content=" Загрузить JSON " Click="BtnLoad_Click" Margin="0,0,5,0"/>
                <Button Content=" Сохранить JSON " Click="BtnSave_Click"/>
            </StackPanel>
            
            <DataGrid x:Name="DataGridTasks" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionChanged="DataGridTasks_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="1.5*"/>
                    <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="*"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                    <DataGridTextColumn Header="Срок" Binding="{Binding DueDate, StringFormat=d}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

       
        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="10">
            <StackPanel>
                <TextBlock Text="Детали задачи" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="Название:"/>
                <TextBox x:Name="TxtTitle" Margin="0,0,0,10"/>

                <TextBlock Text="Описание:"/>
                <TextBox x:Name="TxtDescription" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

                <TextBlock Text="Срок выполнения:"/>
                <DatePicker x:Name="DpDueDate" Margin="0,0,0,10"/>

                <TextBlock Text="Приоритет:"/>
                <ComboBox x:Name="CmbPriority" Margin="0,0,0,10"/>

                <TextBlock Text="Статус:"/>
                <ComboBox x:Name="CmbStatus" Margin="0,0,0,15"/>

                <Button Content="Добавить новую" Click="BtnAdd_Click" Margin="0,0,0,5"/>
                <Button Content="Сохранить изменения" Click="BtnUpdate_Click" Margin="0,0,0,5"/>
                <Button Content="Удалить выбранную" Click="BtnDelete_Click" Foreground="Red"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>